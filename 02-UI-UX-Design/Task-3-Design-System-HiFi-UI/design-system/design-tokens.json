  },
  "typography": {
    "Display": {
      "font": "Inter 800",
      "size": 36,
      "lineHeight": 44,
      "use": "Splash / onboarding hero"
    },
    "Headline": {
      "font": "Inter 800",
      "size": 28,
      "lineHeight": 36,
      "use": "Screen hero titles"
    },
    "Title L": {
      "font": "Inter 700",
      "size": 20,
      "lineHeight": 28,
      "use": "App bar, persona names"
    },
    "Title M": {
      "font": "Inter 600",
      "size": 16,
      "lineHeight": 24,
      "use": "Card & section titles, buttons"
    },
    "Body L": {
      "font": "Inter 400",
      "size": 16,
      "lineHeight": 24,
      "use": "Form values, paragraphs"
    },
    "Body M": {
      "font": "Inter 400",
      "size": 14,
      "lineHeight": 20,
      "use": "List rows, menu items"
    },
    "Label": {
      "font": "Inter 600",
      "size": 12,
      "lineHeight": 16,
      "use": "Field labels, chips, eyebrows (caps +6%)"
    },
    "Caption": {
      "font": "Inter 400",
      "size": 12,
      "lineHeight": 16,
      "use": "Helper / timestamps (min size)"
    }
  },
  "spacing": [
    4,
    8,
    12,
    16,
    24,
    32,
    48
  ],
  "radius": {
    "xs": 6,
    "sm": 10,
    "md": 12,
    "lg": 16,
    "xl": 20,
    "pill": 999
  },
  "elevation": {
    "0": "none",
    "1": "0 1px 2px rgba(10,31,68,.08)",
    "2": "0 8px 20px rgba(10,31,68,.18)"
  },
  "touchTargetMin": 48,
  "grid": {
    "mobile": "4 col \u00b7 16 margin \u00b7 16 gutter",
    "tablet": "8 col \u00b7 24 margin \u00b7 16 gutter",
    "desktop": "12 col \u00b7 32 margin \u00b7 24 gutter, max 1280"
  }
}