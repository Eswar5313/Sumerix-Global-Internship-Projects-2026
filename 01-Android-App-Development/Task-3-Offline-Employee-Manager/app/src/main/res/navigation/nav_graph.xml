<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/employeeListFragment">

    <fragment android:id="@+id/employeeListFragment" android:name="com.eswar.employeemanager.ui.list.EmployeeListFragment"
        android:label="@string/title_list">
        <action android:id="@+id/action_list_to_detail" app:destination="@id/employeeDetailFragment" />
        <action android:id="@+id/action_list_to_edit" app:destination="@id/addEditEmployeeFragment" />
    </fragment>

    <fragment android:id="@+id/employeeDetailFragment" android:name="com.eswar.employeemanager.ui.detail.EmployeeDetailFragment"
        android:label="@string/title_detail">
        <argument android:name="employeeId" app:argType="long" />
        <action android:id="@+id/action_detail_to_edit" app:destination="@id/addEditEmployeeFragment" />
    </fragment>

    <fragment android:id="@+id/addEditEmployeeFragment" android:name="com.eswar.employeemanager.ui.edit.AddEditEmployeeFragment"
        android:label="@string/title_form">
        <argument android:name="employeeId" app:argType="long" android:defaultValue="0L" />
    </fragment>

    <fragment android:id="@+id/statsFragment" android:name="com.eswar.employeemanager.ui.stats.StatsFragment"
        android:label="@string/title_stats" />
</navigation>
