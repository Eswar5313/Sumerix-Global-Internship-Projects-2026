<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Base.Theme.Profile" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorOnPrimary">@color/brand_on_primary</item>
        <item name="colorPrimaryContainer">@color/brand_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/brand_on_primary_container</item>
        <item name="colorSecondary">@color/brand_secondary</item>
        <item name="colorOnSecondary">@color/brand_on_secondary</item>
        <item name="colorSecondaryContainer">@color/brand_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/brand_on_secondary_container</item>
        <item name="android:colorBackground">@color/brand_background</item>
        <item name="colorSurface">@color/brand_surface</item>
        <item name="colorOnSurface">@color/brand_on_surface</item>
        <item name="colorOnSurfaceVariant">@color/brand_on_surface_variant</item>
        <item name="colorOutline">@color/brand_outline</item>
        <item name="materialCardViewStyle">@style/Widget.Profile.Card</item>
    </style>

    <style name="Theme.Profile" parent="Base.Theme.Profile" />

    <style name="Theme.Profile.Splash" parent="Theme.Profile">
        <item name="android:windowBackground">@color/navy</item>
    </style>

    <style name="Widget.Profile.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardCornerRadius">@dimen/card_radius</item>
        <item name="strokeColor">@color/brand_outline</item>
        <item name="cardBackgroundColor">@color/brand_surface</item>
    </style>

    <style name="TextAppearance.Profile.SectionTitle" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textColor">@color/brand_primary</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="TextAppearance.Profile.Eyebrow" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textColor">@color/brand_secondary</item>
        <item name="android:letterSpacing">0.08</item>
        <item name="android:textAllCaps">true</item>
    </style>
</resources>
