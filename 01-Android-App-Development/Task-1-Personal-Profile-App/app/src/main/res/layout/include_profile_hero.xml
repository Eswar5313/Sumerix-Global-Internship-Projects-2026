<?xml version="1.0" encoding="utf-8"?>
<!-- Reusable hero block (name, headline, avatar) shared by phone and tablet layouts -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/hero_background"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="@dimen/screen_padding"
    android:paddingTop="@dimen/space_l"
    android:paddingEnd="@dimen/screen_padding"
    android:paddingBottom="@dimen/space_l">

    <TextView
        android:id="@+id/avatar_initials"
        android:layout_width="@dimen/avatar_size"
        android:layout_height="@dimen/avatar_size"
        android:background="@drawable/bg_avatar"
        android:contentDescription="@string/profile_name"
        android:gravity="center"
        android:textColor="@color/navy"
        android:textSize="36sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_m"
        android:text="@string/profile_name"
        android:textAppearance="?attr/textAppearanceHeadlineSmall"
        android:textColor="@color/hero_text"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_xs"
        android:gravity="center"
        android:text="@string/profile_headline"
        android:textAppearance="?attr/textAppearanceBodyLarge"
        android:textColor="@color/gold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_s"
        android:gravity="center"
        android:text="@string/profile_credentials"
        android:textAppearance="?attr/textAppearanceBodySmall"
        android:textColor="@color/hero_subtext" />

    <com.google.android.material.chip.Chip
        style="@style/Widget.Material3.Chip.Assist"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_s"
        android:clickable="false"
        android:text="@string/profile_location"
        android:textColor="@color/white"
        app:chipBackgroundColor="@color/navy_700"
        app:chipStrokeWidth="0dp"
        xmlns:app="http://schemas.android.com/apk/res-auto" />
</LinearLayout>
