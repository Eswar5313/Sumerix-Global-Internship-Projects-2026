<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingVertical="@dimen/space_xs">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <TextView android:id="@+id/team_name" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:textAppearance="?attr/textAppearanceBodyMedium" />
        <TextView android:id="@+id/team_count" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceLabelLarge" android:textColor="?attr/colorPrimary" />
    </LinearLayout>
    <com.google.android.material.progressindicator.LinearProgressIndicator android:id="@+id/team_progress"
        android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp"
        app:indicatorColor="?attr/colorPrimary" app:trackColor="?attr/colorPrimaryContainer"
        app:trackCornerRadius="4dp" app:trackThickness="6dp" />
</LinearLayout>
